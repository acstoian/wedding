generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guest {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String?
  attending           String   @default("pending") // "yes", "no", "pending"
  plusOne              Boolean  @default(false)
  plusOneName          String?  // legacy — pre-grouping concatenated names
  menuPreference      String?  // "Normal" | "Vegetarian"
  plusOneMenu         String?  // legacy — pre-grouping concatenated menus
  allergies           String?  // allergy details, null if none
  kidsCount           Int?     // household-level (lives on the primary)
  dietaryRestrictions String?  // legacy field
  message             String?  // household-level (lives on the primary)
  tableId             Int?
  seatNumber          Int?     // 1..capacity within their assigned table; null = no specific seat
  table               Table?   @relation(fields: [tableId], references: [id])
  // Self-relation grouping members of the same RSVP submission together.
  // Primary guests have parentGuestId = null. Plus-ones point at their primary.
  // onDelete: SetNull so deleting a primary turns +1s into orphan primaries (safer than cascading data loss).
  parentGuestId       Int?
  parent              Guest?   @relation("GuestGroup", fields: [parentGuestId], references: [id], onDelete: SetNull)
  plusOnes            Guest[]  @relation("GuestGroup")
  createdAt           DateTime @default(now())
}

model Table {
  id       Int     @id @default(autoincrement())
  name     String
  capacity Int     @default(8)
  guests   Guest[]
}
